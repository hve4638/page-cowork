# 배포 디렉터리 루트에 .env 로 복사해 쓴다 (docker-compose.yml 과 같은 위치, source/ 밖).
#   cp source/deploy/.env.template .env
# docker compose 가 이 파일을 읽어 docker-compose.yml 의 ${...} 를 치환한다. 비워 둔 값은 서버가 미설정으로 본다.
# 키가 들어가므로 이 파일은 저장소에 올리지 않는다.

# ── compose ──
# 호스트에서 열 포트. 리버스 프록시 뒤에 둘 때는 docker-compose.yml 에서 127.0.0.1 로 좁힌다
COWORK_PORT=8080
# /data 로 마운트할 호스트 경로. cowork.db · files/ · recordings/ · whitelist.txt · admin.txt 가 놓인다
COWORK_DATA=/nas/storage1/.volume/cowork

# ── AI 회의 노트: 전사 ──
# mock | speechmatics. 비우면 mock (가짜 결과)
STT_PROVIDER=
# speechmatics 키
STT_API_KEY=
# 일괄 전사 주소. 비우면 서비스 기본
STT_BASE_URL=
# 실시간 전사 WebSocket 주소. 비우면 서비스 기본
STT_LIVE_URL=
# 언어 코드. 비우면 ko
STT_LANGUAGE=

# ── AI 회의 노트: 요약 ──
# mock | chat. chat 은 OpenAI chat completions 형식이면 어디든 붙는다. 비우면 mock
LLM_PROVIDER=
LLM_API_KEY=
# 예: http://my-agent:8080/v1 (<LLM_BASE_URL>/chat/completions 로 요청한다)
LLM_BASE_URL=
# 기본 모델. 비우면 LLM_MODELS 의 첫 항목
LLM_MODEL=
# 노트에서 골라 쓸 모델 목록. 예: gpt-5.6-luna=Luna,gpt-5.6-terra=Terra
LLM_MODELS=

# ── 개발·데모 전용. 실서비스에서는 주석인 채로 둔다 ──
# 세션 없는 요청을 이 이메일의 사용자로 취급
#DEV_AUTO_LOGIN=admin@example.com
# 기동 시 이 계정이 없으면 만들고 admin.txt 에 없어도 관리자로 취급
#DEV_ADMIN_EMAIL=admin@example.com
# 위 계정의 비밀번호. 이미 있는 계정이면 바꾸지 않는다
#DEV_ADMIN_PW=change-me
# 위 계정의 닉네임. 비우면 이메일의 @ 앞부분
#DEV_ADMIN_NAME=
