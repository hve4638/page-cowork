    "clsx": "^2.1.1",
    "codemirror-live-markdown": "0.5.1-alpha.1",
    "diff-match-patch": "^1.0.5",
    "i18next": "^24.2.1",
    "pdfjs-dist": "5.4.296",
    "rc-slider": "^11.1.8",
